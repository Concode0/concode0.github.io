---
import { getCollection } from "astro:content";
import { Image } from "astro:assets"

import Layout from "@/layouts/Layout.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import PostCard from "@/components/PostCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Link from "@/components/shared/Link.astro";
import convertAsteriskToStrongTag from "@/utils/convertAsteriskToStrongTag";

import presentation from "@/data/presentation";
import { projects, openSourceWork } from "@/data/projects";

const posts = (await getCollection("posts"))
  .filter((post) => 
    post.data.isPublish && 
    !post.data.isDraft && 
    post.data.publishedAt <= new Date()
  )
  .sort((first, second) => 
    second.data.publishedAt.getTime() - first.data.publishedAt.getTime()
  );
---

<Layout>
  <main class="flex flex-col gap-20">
    <article
      class="flex flex-col gap-8 md:flex-row-reverse md:justify-end md:gap-12"
    >
      {
        presentation.profile && (
          <Image
            src={presentation.profile}
            class="w-1/4 self-center rounded-full"
            alt="Your Profile"
            width="200"
            height="200"
          />
        )
      }

      <div class="flex flex-col gap-8">
        <h1 class="text-4xl font-medium tracking-tight text-neutral-100">
          {presentation.title}
        </h1>

        <h2
          class="w-auto max-w-[58ch] text-lg leading-7"
          set:html={convertAsteriskToStrongTag(presentation.description)}
        />

        <SocialLinks />
      </div>
    </article>

    <article class="flex flex-col gap-8">
      <header>
        <h3 class="text-lg text-neutral-100">
          01 — Projects
        </h3>
      </header>

      <section class="flex flex-col gap-4">
        {
          projects.map((project) => (
            <ProjectCard {...project} />
          ))
        }
      </section>
    </article>

    <article class="flex flex-col gap-8">
      <header>
        <h3 class="text-lg text-neutral-100">
          02 — Upstream
        </h3>
      </header>

      <section class="flex flex-col gap-4">
        {
          openSourceWork.map((project) => (
            <ProjectCard {...project} />
          ))
        }
      </section>
    </article>

    <article class="flex flex-col gap-8">
      <header class="flex w-full flex-row justify-between gap-2">
        <h3 class="text-lg text-neutral-100">Notes</h3>
        <Link href="/posts" label="See all notes" isUnderline target="_self" />
      </header>
      {posts.length === 0 && <p>Soon, stay connected 👀...</p>}

      <section class="flex flex-col gap-4 md:flex-row md:flex-wrap">
        {
          posts.length !== 0 &&
            posts
              .slice(0, 2)
              .map((post) => (
                <PostCard
                  publishedAt={post.data.publishedAt}
                  title={post.data.title}
                  description={post.data.description}
                  slug={post.id}
                />
              ))
        }
      </section>
    </article>


    <article class="flex flex-col gap-8">
      <header class="flex w-full flex-row justify-between gap-2">
        <h3 class="text-lg text-neutral-100">Get in touch</h3>
      </header>
      <p>
        Email me at <Link
          href={`mailto:${presentation.mail}`}
          label={presentation.mail}
        />
      </p>

      <SocialLinks />
    </article>
  </main>
</Layout>
