---
import type { TailwindColor } from "@/utils/types/tailwind";
import { MAP_COLOR_VARIANT_TO_RGB } from "@/utils/mapVariants";

type Props = {
  position: "bottom" | "top";
  color: TailwindColor;
};

const { position, color } = Astro.props;
const rgb = MAP_COLOR_VARIANT_TO_RGB[color];
---

<div
  aria-hidden="true"
  class:list={{
    "pointer-events-none fixed z-0 h-[360px] w-[360px] md:h-[600px] md:w-[600px]": true,
    "-left-[180px] -top-[180px] md:-left-[300px] md:-top-[300px]":
      position === "top",
    "-bottom-[180px] -right-[180px] md:-bottom-[300px] md:-right-[300px]":
      position === "bottom",
  }}
  style={`background: radial-gradient(
    circle,
    rgb(${rgb} / 0.28) 0%,
    rgb(${rgb} / 0.12) 35%,
    rgb(${rgb} / 0.04) 55%,
    transparent 72%
  );`}
></div>