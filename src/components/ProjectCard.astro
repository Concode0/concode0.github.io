---
import type { Project } from "@/data/projects";

type Props = Project;

const { title, description, techs, link } = Astro.props;

const formatTechs = (values: string[]) =>
  values.join(" · ");
---

<a
  class="group block border-l border-neutral-800 py-1 pl-4 transition-colors duration-200 hover:border-cyan-400"
  href={link}
  target="_blank"
>
  <div class="flex items-start justify-between gap-6">
    <div class="flex flex-col gap-2">
      <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:gap-4">
        <p
          class="font-medium text-neutral-100 transition-colors group-hover:text-cyan-300"
        >
          {title}
        </p>

        <p
          class="font-mono text-[11px] uppercase tracking-[0.1em] text-neutral-500"
        >
          {formatTechs(techs)}
        </p>
      </div>

      {
        description && (
          <p class="max-w-[65ch] leading-6 text-neutral-400">
            {description}
          </p>
        )
      }
    </div>

    <span
      class="font-mono text-xs text-neutral-600 transition-colors group-hover:text-cyan-300"
    >
      ↗
    </span>
  </div>
</a>